<%- include('partials/header', { title: 'Student List' }) %>

<h1>Student List</h1>

<div class="toolbar">
  <form class="search-form" action="/students/search" method="GET">
    <input type="text" name="keyword" placeholder="Search student...">
    <button type="submit" class="btn">Search</button>
  </form>
  <a class="btn btn-primary" href="/students/add">Add Student</a>
</div>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Student ID</th>
        <th>Name</th>
        <th>Course</th>
        <th>Year</th>
        <th>Email</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (students.length === 0) { %>
        <tr><td colspan="7" class="empty">No students found.</td></tr>
      <% } else { %>
        <% students.forEach(student => { %>
          <tr>
            <td><%= student.id %></td>
            <td><%= student.student_id %></td>
            <td><%= student.first_name %> <%= student.last_name %></td>
            <td><%= student.course %></td>
            <td><%= student.year_level %></td>
            <td><%= student.email %></td>
            <td>
              <form action="/students/delete/<%= student.id %>" method="POST"
                    onsubmit="return confirm('Delete this student?');">
                <button type="submit" class="btn btn-danger">Delete</button>
              </form>
            </td>
          </tr>
        <% }); %>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>